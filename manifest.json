{
  "manifest_version": 3,
  "name": "ZeroSlop: Community-Powered AI Detector for X",
  "version": "1.6.0",
  "description": "The forensic shield for your timeline. Instantly detect, highlight, and zap AI-generated 'slop' and bot networks on X (Twitter).",
  "permissions": [
    "storage",
    "contextMenus",
    "offscreen",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.zerogpt.com/*",
    "https://twitter.com/*",
    "https://x.com/*",
    "https://firestore.googleapis.com/*",
    "https://raw.githubusercontent.com/*",
    "https://pbs.twimg.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ],
      "js": [
        "classifier.js",
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "model_weights.json"
      ],
      "matches": [
        "https://twitter.com/*",
        "https://x.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}