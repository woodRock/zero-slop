rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Slop Registry: Publicly readable, community-reported registry
    match /slop_registry/{tweetId} {
      allow read: if true;
      allow write: if 
        request.resource.data.tweet_id == tweetId &&
        request.resource.data.status == "pending" &&
        (!('ai_score' in request.resource.data) || 
         (request.resource.data.ai_score >= 0 && request.resource.data.ai_score <= 100)) &&
        (!('upvotes' in request.resource.data) || request.resource.data.upvotes >= 0) &&
        (!('downvotes' in request.resource.data) || request.resource.data.downvotes >= 0);
      allow delete: if false;
    }

    // Slop Accounts: Publicly readable registry of AI-slop posting accounts
    match /slop_accounts/{accountId} {
      allow read: if true;
      allow create, update: if request.resource.data.handle is string;
      allow delete: if false;
    }

    // Image Registry: on-device AI-image detector scores, keyed by the image's path on X's CDN.
    // Scores come from users' browsers, so they're a community hint, not proof.
    match /image_registry/{mediaId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.media_id == mediaId &&
        request.resource.data.ai_score is number &&
        request.resource.data.ai_score >= 0 && request.resource.data.ai_score <= 100 &&
        (!('checks' in request.resource.data) || request.resource.data.checks >= 0) &&
        (!('score_sum' in request.resource.data) || request.resource.data.score_sum >= 0) &&
        (!('upvotes' in request.resource.data) || request.resource.data.upvotes >= 0) &&
        (!('downvotes' in request.resource.data) || request.resource.data.downvotes >= 0);
      allow delete: if false;
    }

    // Suspicious Accounts: Track retweeters of slop
    match /suspicious_accounts/{accountId} {
      allow read: if true;
      allow create, update: if request.resource.data.handle is string;
      allow delete: if false;
    }

    // Stats collection: Publicly readable, restricted updates
    match /stats/{docId} {
      allow read: if true;
      allow write: if docId == "global";
    }

    // Weekly Audits: Publicly readable
    match /weekly_audits/{auditId} {
      allow read: if true;
      allow create, update: if request.resource.data.total_slops is int;
    }

    // Trends: Daily volume tracking
    match /trends/{dateId} {
      allow read: if true;
      allow write: if true;
    }

    // Human Registry: Verified human-generated tweets (research access)
    match /human_registry/{tweetId} {
      allow read: if true;
      allow write: if request.resource.data.label == "organic-human";
    }

    // Catch-all deny for safety
    match /{document=**} {
      allow read: if true; // Allow all reads for debugging/transparency
      allow write: if false;
    }
  }
}
